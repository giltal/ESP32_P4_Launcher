# Elecrow All-in-one Starter Kit for ESP32-P4 (SEE00804D, 7" 1024x600) — board-specific sdkconfig fragment.
# Flash, PSRAM, chip revision and the C6 wiring from Elecrow's own AI project sdkconfig (P4-All-in-one-AI).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Elecrow builds for a pre-v3 ESP32-P4 (rev v1.x): check with `esptool chip_id`
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# ESP32-C6 on SDIO slot 1, 4-bit, with the kit's own wiring: CLK 14, CMD 15, D0 7, D1 9, D2 10, D3 11,
# reset GPIO 2 (active high). The C6's factory firmware is esp_hosted over SDIO.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=7
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=11
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=2
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
# esp_hosted 2.12 takes its SDIO buffer pools from internal RAM; keep them small
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=12
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=12
# The speaker amp's current peaks dip the 3.3 V rail on weak USB supplies
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y

# BLE for apps (BLE interface): NimBLE host on the P4, controller on the C6 over esp_hosted (VHCI).
# The host only runs while a BLE app does; its memory comes from PSRAM. Needs a C6 firmware with
# BLE over VHCI (the release's 2.12.13 one, Settings > Update), else BLE stays unavailable.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
