# Fitted 16 MB flash on the PAX AIO/Nano units was checked at revision >= 1.0.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ETH_USE_ESP32_EMAC=y
# Replace the factory SDIO default with the AIO PAX SPI full-duplex module.
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=n
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=n
CONFIG_ESP_HOSTED_SPI_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SPI_GPIO_HANDSHAKE=11
CONFIG_ESP_HOSTED_SPI_GPIO_DATA_READY=10
CONFIG_ESP_HOSTED_SPI_GPIO_RESET_SLAVE=2
CONFIG_ESP_HOSTED_SPI_RESET_ACTIVE_HIGH=y
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y

# User-settable SPI pins; SPI_GPIO_* are derived symbols in esp_hosted 2.12.
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_MOSI=7
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_MISO=9
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_CLK=15
CONFIG_ESP_HOSTED_SPI_HSPI_GPIO_CS=14
